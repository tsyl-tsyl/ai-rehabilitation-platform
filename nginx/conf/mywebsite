server {
    server_name  www.bnstw.com bnstw.com;
    
   
    # 专门处理 /ai/frontend/ 路径
    location /ai/frontend/ {
        alias /home/ubuntu/ai/frontend/;
        index index.html index.htm;
        
        # SPA 路由支持
        try_files $uri $uri/ /ai/frontend/index.html;
        
        # 静态资源缓存
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
        }
    }
    
        # 新增：反向代理 /api 路径到后端 8000 端口（HTTPS 映射）
    location /api {
        proxy_pass http://127.0.0.1:8000/api;  # 指向本地 HTTP 服务
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;  # 告诉后端是 HTTPS 请求
    }    
    # 其他位置...
    location / {
        # 可以设置默认页面或返回 404
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
     location /ai/docs/ {
        # 设置实际文件路径
        alias /home/ubuntu/ai/docs/;
        
        # 启用自动索引（可选，如果目录下有多个文件）
        autoindex on;
        
        # 设置正确的MIME类型
        types {
            video/mp4 mp4;
            application/pdf pdf;
            text/plain txt;
            text/html html;
        }
        
        # 安全设置
        location ~* \.(mp4|pdf|txt|html)$ {
            # 允许跨域访问（如果需要）
            add_header Access-Control-Allow-Origin *;
            
            # 缓存设置
            expires 1h;
            
            # 安全头
            add_header X-Content-Type-Options nosniff;
        }
    }
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/bnstw.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/bnstw.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.bnstw.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = bnstw.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name  www.bnstw.com bnstw.com;
    return 404; # managed by Certbot




}
